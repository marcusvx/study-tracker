PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Local: docker-compose Postgres. Production: Supabase connection string
# (Project Settings > Database > Connection string), which also gets SSL
# automatically once NODE_ENV=production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_tracker_app

# Supabase Auth (required in every environment).
# Tokens are verified against Supabase's JWKS endpoint, built from this URL.
# Find it in Supabase dashboard: Project Settings > API > Project URL
SUPABASE_URL=

# Supabase Auth user UUID for the local seed profile (required for db:seed).
# Find it in Supabase dashboard: Authentication > Users
SEED_USER_ID=

# Internal reminder dispatcher (caller-agnostic: any allowlisted IP + secret).
# cron-job.org current executor IPs: https://api.cron-job.org/executor-nodes.json
CRON_SECRET=change-me-to-a-long-random-string
CRON_ALLOWED_IPS=127.0.0.1,::1,116.203.134.67,116.203.129.16,23.88.105.37,128.140.8.200,91.99.23.109

# Reminder matching window (minutes) and timezone for HH:mm reminderTime values.
REMINDERS_WINDOW_MINUTES=5
REMINDERS_TIMEZONE=America/Sao_Paulo

# OpenTelemetry (optional). Without OTEL_EXPORTER_OTLP_ENDPOINT, logs go to console.
# Set OTEL_SDK_DISABLED=true to turn telemetry off entirely.
# OTEL_SERVICE_NAME=study-tracker-backend
# OTEL_DEPLOYMENT_ENVIRONMENT=development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console
# OTEL_SDK_DISABLED=false