PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Local: docker-compose Postgres. Production: Supabase connection string
# (Project Settings > Database > Connection string), which also gets SSL
# automatically once NODE_ENV=production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_tracker_app

# Supabase Auth (required in every environment).
# Tokens are verified against Supabase's JWKS endpoint, built from this URL.
# Find it in Supabase dashboard: Project Settings > API > Project URL
SUPABASE_URL=
